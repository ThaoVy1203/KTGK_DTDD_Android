<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_1"
    tools:context=".MainActivity">


    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="THÔNG TIN HỌC SINH"
        android:textColor="@color/brown"
        android:textSize="35dp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.209" />

    <EditText
        android:id="@+id/edtHoTen"
        android:layout_width="311dp"
        android:layout_height="45dp"
        android:background="@drawable/bg_text"
        android:backgroundTint="@color/white"
        android:ems="10"
        android:inputType="text"
        android:textColorHint="#BEBEBE"
        android:hint="Nhập họ tên"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/textView"
        app:layout_constraintHorizontal_bias="0.583"
        app:layout_constraintStart_toStartOf="@+id/textView"
        app:layout_constraintTop_toBottomOf="@+id/textView"
        app:layout_constraintVertical_bias="0.071" />

    <EditText
        android:id="@+id/edtMSV"
        android:layout_width="310dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_text"
        android:backgroundTint="@color/white"
        android:ems="10"
        android:textColorHint="#BEBEBE"
        android:hint="Nhập MSV"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/edtHoTen"
        app:layout_constraintStart_toStartOf="@+id/edtHoTen"
        app:layout_constraintTop_toBottomOf="@+id/edtHoTen"
        app:layout_constraintVertical_bias="0.088" />

    <EditText
        android:id="@+id/edtDTB"
        android:layout_width="317dp"
        android:layout_height="41dp"
        android:background="@drawable/bg_text"
        android:backgroundTint="@color/white"
        android:ems="10"
        android:inputType="numberDecimal"
        android:textColorHint="#BEBEBE"
        android:hint="Nhập điểm trung bình"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/edtMSV"
        app:layout_constraintStart_toStartOf="@+id/edtMSV"
        app:layout_constraintTop_toBottomOf="@+id/edtMSV"
        app:layout_constraintVertical_bias="0.07999998" />

    <Button
        android:id="@+id/btnKQ"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/brown"
        android:text="Xem kết quả"
        android:textSize="20dp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/edtDTB"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@+id/edtDTB"
        app:layout_constraintTop_toBottomOf="@+id/edtDTB"
        app:layout_constraintVertical_bias="0.27" />
</androidx.constraintlayout.widget.ConstraintLayout>